@model ApplyFlow.Web.ViewModels.RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Create account";
}

<p class="eyebrow">Create your account</p>
<h2>Start tracking your progress</h2>
<p class="authDescription">
    Create an account for your ApplyFlow workspace.
</p>

<form asp-controller="Accounts" asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly"
         class="validationSummary" role="alert"></div>

    <div class="authField">
        <label asp-for="DisplayName"></label>
        <input asp-for="DisplayName" autocomplete="nickname" />
        <span asp-validation-for="DisplayName"></span>
    </div>

    <div class="authField">
        <label asp-for="Email"></label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="authField">
        <label asp-for="Password"></label>
        <input asp-for="Password"
               autocomplete="new-password"
               aria-describedby="passwordHelp" />
        <small id="passwordHelp">
            Use 10 to 128 characters, including an uppercase letter,
            a lowercase letter and a number.
        </small>
        <span asp-validation-for="Password"></span>
    </div>

    <div class="authField">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button class="authButton" type="submit">Create account</button>
</form>

<p class="authSwitch">
    Already have an account?
    <a asp-controller="Accounts" asp-action="Login">Sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}