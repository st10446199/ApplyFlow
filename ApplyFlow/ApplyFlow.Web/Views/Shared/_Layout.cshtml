@using Microsoft.AspNetCore.Identity
@using ApplyFlow.Web.Models
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ApplyFlow</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/accountMenu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApplyFlow.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["action"]?.ToString();

        var isDashboard =
            currentController == "Home" && currentAction == "Index";

        var isApplications =
            currentController == "Applications";

        var isApplicationsList =
            isApplications && currentAction == "Index";

        var currentUser = User.Identity?.IsAuthenticated == true
            ? await UserManager.GetUserAsync(User)
            : null;
    }

    <a class="skipLink" href="#mainContent">Skip to content</a>

    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="brandMark" aria-hidden="true">
                A<span>↗</span>
            </span>
            <span>Apply<span class="brandAccent">Flow</span></span>
        </a>

        <nav class="desktopNav" aria-label="Main navigation">
            <p class="navLabel">Workspace</p>

            <a class="navLink @(isDashboard ? "active" : "")"
               asp-controller="Home"
               asp-action="Index"
               aria-current="@(isDashboard ? "page" : null)">
                <span aria-hidden="true">▦</span>
                Dashboard
            </a>

            <a class="navLink @(isApplications ? "active" : "")"
               asp-controller="Applications"
               asp-action="Index"
               aria-current="@(isApplicationsList ? "page" : null)">
                <span aria-hidden="true">▤</span>
                Applications
            </a>

            <span class="navLink unavailable">
                <span aria-hidden="true">▣</span>
                Interviews
                <small>Planned</small>
            </span>
        </nav>

        <div class="sidebarFooter">
            <strong>Your next opportunity starts here.</strong>
            <p>Keep every application and next step in one place.</p>
            <span>ApplyFlow · Portfolio project</span>
        </div>
    </aside>

    <div class="workspace">
        <header class="topbar">
            <span class="pageTitle">@ViewData["Title"]</span>

            @if (currentUser is not null)
            {
                <div class="accountMenu">
                    <span class="accountName">@currentUser.DisplayName</span>

                    <form asp-controller="Accounts"
                          asp-action="Logout"
                          method="post">
                        <button class="logoutButton" type="submit">
                            Log out
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a asp-controller="Accounts" asp-action="Login">
                    Sign in
                </a>
            }
        </header>

        <details class="mobileNavigation">
            <summary>ApplyFlow navigation</summary>

            <nav aria-label="Mobile navigation">
                <a asp-controller="Home"
                   asp-action="Index"
                   aria-current="@(isDashboard ? "page" : null)">
                    Dashboard
                </a>

                <a asp-controller="Applications"
                   asp-action="Index"
                   aria-current="@(isApplicationsList ? "page" : null)">
                    Applications
                </a>

                <span>Interviews · Planned</span>
            </nav>
        </details>

        <main id="mainContent" class="mainContent" tabindex="-1">
            @RenderBody()
        </main>

        <footer class="pageFooter">
            <span>&copy; @DateTime.UtcNow.Year ApplyFlow</span>
            <span>Built with ASP.NET Core MVC</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>