@model ApplyFlow.Web.ViewModels.DashboardViewModel
@using ApplyFlow.Web.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
    var displayCulture = CultureInfo.GetCultureInfo("en-ZA");
}

<link rel="stylesheet"
      href="~/css/applications.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/dashboard.css"
      asp-append-version="true" />

<section class="welcome">
    <div>
        <p class="eyebrow">Your job search, organised</p>
        <h1>Every opportunity in one place.</h1>
        <p class="muted">
            Track your progress and keep your next step in sight.
        </p>
    </div>

    <a class="applicationsPrimary"
       asp-controller="Applications"
       asp-action="Index">
        View applications
    </a>
</section>

<section class="statsGrid" aria-label="Your application statistics">
    <article class="statCard">
        <span class="statIcon blue" aria-hidden="true">▤</span>
        <div>
            <h2>Total applications</h2>
            <strong class="statValue">@Model.TotalApplications</strong>
            <p>All tracked opportunities</p>
        </div>
    </article>

    <article class="statCard">
        <span class="statIcon teal" aria-hidden="true">↗</span>
        <div>
            <h2>Active applications</h2>
            <strong class="statValue">@Model.ActiveApplications</strong>
            <p>Applied, assessment or interview</p>
        </div>
    </article>

    <article class="statCard">
        <span class="statIcon amber" aria-hidden="true">▣</span>
        <div>
            <h2>Saved opportunities</h2>
            <strong class="statValue">@Model.SavedApplications</strong>
            <p>Vacancies saved for later</p>
        </div>
    </article>

    <article class="statCard">
        <span class="statIcon green" aria-hidden="true">✓</span>
        <div>
            <h2>Offers</h2>
            <strong class="statValue">@Model.Offers</strong>
            <p>Applications currently at offer stage</p>
        </div>
    </article>
</section>

@if (Model.TotalApplications == 0)
{
    <section class="panel applicationsEmpty">
        <span class="emptyApplicationIcon" aria-hidden="true">▤</span>
        <h2>Start tracking your opportunities</h2>
        <p>
            Add your first application to see your progress here.
            Your dashboard updates as you manage your applications.
        </p>

        <a class="applicationsPrimary"
           asp-controller="Applications"
           asp-action="Create">
            Add your first application
        </a>
    </section>
}
else
{
    <div class="dashboardGrid">
        <section class="panel" aria-labelledby="statusTitle">
            <div class="panelHeading">
                <h2 id="statusTitle">Application status</h2>
                <p>Select a status to view its applications.</p>
            </div>

            <div class="statusSummary">
                <strong>@Model.TotalApplications</strong>
                <span class="muted">Total tracked</span>
            </div>

            <ul class="dashboardStatusList">
                @foreach (var status in Enum.GetValues<ApplicationStatus>())
                {
                    var count = Model.CountFor(status);
                    var statusClass = status.ToString().ToLowerInvariant();
                    var percentage = Model.PercentageFor(status)
                        .ToString("0.##", CultureInfo.InvariantCulture);

                    <li>
                        <a class="dashboardStatusLink"
                           asp-controller="Applications"
                           asp-action="Index"
                           asp-route-status="@status"
                           aria-label="@status applications: @count">
                            <span class="badge @statusClass">@status</span>
                            <strong>@count</strong>
                        </a>

                        <div class="dashboardStatusTrack" aria-hidden="true">
                            <span class="dashboardStatusFill @statusClass"
                                  style="width: @(percentage)%"></span>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <section class="panel dashboardNextStep"
                 aria-labelledby="nextStepTitle">
            <div class="panelHeading">
                <h2 id="nextStepTitle">Your next step</h2>
                <p>Keep your job search moving.</p>
            </div>

            @if (Model.SavedApplications > 0)
            {
                <div class="dashboardActionContent">
                    <span class="statIcon amber" aria-hidden="true">▣</span>
                    <h3>Review your saved opportunities</h3>
                    <p>
                        You have @Model.SavedApplications
                        @(Model.SavedApplications == 1 ? "opportunity" : "opportunities")
                        marked as Saved. Review the role requirements and
                        decide which applications to prepare next.
                    </p>

                    <a class="applicationsPrimary"
                       asp-controller="Applications"
                       asp-action="Index"
                       asp-route-status="@ApplicationStatus.Saved">
                        View saved opportunities
                    </a>
                </div>
            }
            else
            {
                <div class="dashboardActionContent">
                    <span class="statIcon teal" aria-hidden="true">↗</span>
                    <h3>Keep your records up to date</h3>
                    <p>
                        Review your applications and update their statuses
                        when you hear from employers. Add useful details
                        to your notes so you can find them later.
                    </p>

                    <a class="applicationsPrimary"
                       asp-controller="Applications"
                       asp-action="Index">
                        Review applications
                    </a>
                </div>
            }

            <p class="dashboardExplanation">
                These totals show each application's current status.
                They do not measure historical interview or offer rates.
            </p>
        </section>
    </div>

    <section class="panel recentPanel" aria-labelledby="recentTitle">
        <div class="dashboardRecentHeading">
            <div class="panelHeading">
                <h2 id="recentTitle">Recent applications</h2>
                <p>Your five most recently added opportunities.</p>
            </div>

            <a asp-controller="Applications"
               asp-action="Index">
                View all applications
            </a>
        </div>

        <ul class="dashboardRecentList">
            @foreach (var application in Model.RecentApplications)
            {
                var companyInitial =
                    string.IsNullOrWhiteSpace(application.CompanyName)
                        ? "?"
                        : StringInfo.GetNextTextElement(
                            application.CompanyName).ToUpperInvariant();

                var statusClass =
                    application.Status.ToString().ToLowerInvariant();

                <li class="dashboardRecentItem">
                    <div class="dashboardRecentCompany">
                        <span class="companyMark" aria-hidden="true">
                            @companyInitial
                        </span>

                        <div class="dashboardRecentDescription">
                            <h3>
                                <a asp-controller="Applications"
                                   asp-action="Details"
                                   asp-route-id="@application.Id"
                                   aria-label="View @application.JobTitle at @application.CompanyName">
                                    @application.CompanyName
                                </a>
                            </h3>
                            <p>@application.JobTitle</p>
                            <p class="dashboardRecentLocation">
                                @application.Location
                            </p>
                        </div>
                    </div>

                    <div class="dashboardRecentMeta">
                        <span class="badge @statusClass">
                            @application.Status
                        </span>

                        <p>
                            <span>Application date:</span>
                            @if (application.ApplicationDate is DateOnly date)
                            {
                                <time datetime="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                                    @date.ToString("dd MMM yyyy", displayCulture)
                                </time>
                            }
                            else
                            {
                                <span>Not recorded</span>
                            }
                        </p>
                    </div>
                </li>
            }
        </ul>
    </section>
}